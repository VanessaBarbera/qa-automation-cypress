{
  "name": "qa-automation-cypress",
  "version": "1.0.0",
  "description": "Portfólio de automação de testes E2E e API com Cypress",
  "private": true,
  "scripts": {
    "cy:open": "cypress open",
    "test:e2e": "cypress run --spec \"cypress/e2e/web/**/*.cy.js\"",
    "test:api": "cypress run --spec \"cypress/e2e/api/**/*.cy.js\"",
    "test": "cypress run"
  },
  "devDependencies": {
    "cypress": "latest"
  },
  "allowScripts": {
    "cypress": true
  }
}
