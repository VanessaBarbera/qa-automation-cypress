{
  "name": "automation-exercise-qa",
  "version": "1.0.0",
  "private": true,
  "description": "10 testes E2E do Automation Exercise com Cypress e GitHub Actions",
  "scripts": {
    "cy:open": "cypress open",
    "test": "cypress run --browser chrome",
    "test:electron": "cypress run --browser electron",
    "report:merge": "mochawesome-merge 'cypress/results/*.json' -o cypress/merged-report.json",
    "report:html": "marge cypress/merged-report.json --reportDir cypress/html-report --reportFilename index.html",
    "report": "npm run report:merge && npm run report:html"
  },
  "devDependencies": {
    "cypress": "15.21.1",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.4.1",
    "mochawesome-report-generator": "^6.2.0"
  }
}
